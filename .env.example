# OPTIONAL, dev-server only. Copy to .env if you want. .env is gitignored.
# The normal way to configure the game is the in-game Settings screen (stored in localStorage).
# Values here are used ONLY when `npm run dev` is running AND nothing is saved in Settings.
# They are ignored in production builds. Never commit real keys.

# Anthropic Claude API key (https://console.anthropic.com/settings/keys)
VITE_CLAUDE_API_KEY=

# Obsidian Local REST API bearer token (Obsidian > Settings > Local REST API)
VITE_OBSIDIAN_TOKEN=

# Obsidian base URL (default shown; self-signed cert, see README)
VITE_OBSIDIAN_BASE_URL=https://127.0.0.1:27124
