# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

# Anthropic Claude API key
# Get one at: https://console.anthropic.com/settings/keys
VITE_CLAUDE_API_KEY=sk-ant-...

# Obsidian Local REST API
# Install the "Local REST API" plugin in Obsidian, then copy the bearer token from its settings.
VITE_OBSIDIAN_TOKEN=your-obsidian-bearer-token

# Obsidian server base URL (default shown — change if you set a custom port)
VITE_OBSIDIAN_BASE_URL=http://127.0.0.1:27123
